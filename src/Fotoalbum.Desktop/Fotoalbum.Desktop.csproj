<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Umožní sestavení i na Linuxu (CI); spustit jde jen ve Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Fotoalbum</AssemblyName>
    <ApplicationIcon>fotoalbum.ico</ApplicationIcon>
    <RootNamespace>Fotoalbum.Desktop</RootNamespace>
    <Product>Fotoalbum</Product>
    <Version>0.3.0</Version>
    <!-- Balíček WebView2 obsahuje i WPF variantu; konflikt verzí WindowsBase se nás netýká. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fotoalbum.Server\Fotoalbum.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <!-- ExifTool pro Windows se přibalí, pokud leží v src/Fotoalbum.Desktop/exiftool (není v repozitáři). -->
  <ItemGroup>
    <None Include="fotoalbum.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="exiftool\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
