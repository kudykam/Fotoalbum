<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Rozhraní (HTML/CSS/JS) je přibalené přímo v knihovně, aby fungovalo i uvnitř Windows aplikace. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\**" />
    <Content Remove="ui\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fotoalbum.Core\Fotoalbum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0" />
  </ItemGroup>

</Project>
